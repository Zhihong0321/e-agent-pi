# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/agent-storage/*
!/agent-storage/.gitkeep
/my-vault/*.key
/my-vault/*.secret
.pi/agent/auth.json
.pi/skills/
.impeccable/
/data/
.tmp*
*.tmp
*.zip
new-template/


# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Generated slide decks, previews, and source artifacts are kept locally only.
/slide/
/document_inteligence/slides/

# multi-tenant test: local fixtures (passwords, cookies) and evidence
tests/multitenant/.fixtures.local.json
tests/multitenant/evidence/

tests/question-menu/.fixtures.local.json
tests/question-menu/evidence/
tests/question-menu/v2/.fixtures-rep*.local.json
tests/question-menu/v2/evidence/

# retired plans, reports and old test evidence; local only (see archive/*/MANIFEST.md)
/archive/
