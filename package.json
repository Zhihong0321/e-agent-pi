{
  "name": "whatsapp-ui-pi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node server/index.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern legacy_archive",
    "pi": "pi",
    "pi:version": "pi --version",
    "test": "npm run test:execution && npm run test:queue",
    "test:execution": "node --experimental-test-module-mocks --test --test-concurrency=1 server/execution/people-service.test.mjs && node --experimental-test-module-mocks --test --test-concurrency=1 server/execution/dispatch.test.mjs && node --experimental-test-module-mocks --test --test-concurrency=1 server/execution/runner.test.mjs && node --test --test-concurrency=1 server/execution/mcp-adapter.test.mjs",
    "test:queue": "node --test server/queue/*.test.mjs",
    "test:company-research": "node --test server/company-research/*.test.mjs",
    "test:ads-research": "node --test server/ads-research/*.test.mjs",
    "test:scheduler": "node --experimental-test-module-mocks --test server/scheduler/*.test.mjs"
  },
  "dependencies": {
    "@composio/core": "^0.18.1",
    "@earendil-works/pi-coding-agent": "latest",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cron-parser": "5.10.1",
    "libphonenumber-js": "1.13.14",
    "mammoth": "^1.13.0",
    "pg": "^8.23.0",
    "pi-mcp-adapter": "^2.32.1",
    "playwright": "^1.62.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "^9.3.10",
    "tldts": "7.4.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.39.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "vite-plugin-pwa": "1.3.0"
  },
  "type": "module"
}
